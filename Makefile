# Forge3D -- top-level build (engine3d + the f3dc compiler).
#
# PARALLEL BUILDS (supported invocations):
#   make -j             # parallel engine build
#   make -j f3dc        # parallel f3dc build (via compiler/)
#   make JOBS=8 f3dc    # JOBS passthrough: forwarded as -j8 to the
#                       # sub-makes in `f3dc` and `debug` (below).
#                       # A bare `make -j` needs no JOBS: the
#                       # jobserver already propagates to sub-makes
#                       # through MAKEFLAGS automatically.
# Parallel safety rests on three things, do not regress them:
#   1. Fortran module compilation ORDER comes from the GENERATED
#      deps (obj/deps.mk): a consumer object depends on the
#      objects of every module it USEs, so a provider's .mod is
#      always fully written into include/ before any consumer
#      compiles.  No hand-ordered source list, no .NOTPARALLEL.
#   2. Directory creation uses only `mkdir -p` (idempotent under
#      concurrency), including inside FORTRAN_COMPILE.
#   3. No recipe writes a fixed shared temp file: deps generation
#      goes through tools/fortran_deps.sh, which writes a unique
#      mktemp file and atomically renames it over obj/deps.mk.
# .DELETE_ON_ERROR below keeps a failed/interrupted parallel
# compile from leaving a partial object make would trust later.

FC = gfortran
FFLAGS = -O3 -Wall -Wextra -fopenmp -Jinclude
DEBUG_FFLAGS = -O3 -Wall -Wextra -fcheck=all -fopenmp -Jinclude

# JOBS passthrough (see header): empty = rely on the command
# line's own -j / the inherited jobserver.
JOBS ?=
JOBS_FLAG = $(if $(strip $(JOBS)),-j$(JOBS),)

SRC_DIR = src
OBJ_DIR = obj
BIN_DIR = bin
MOD_DIR = include

TARGET = $(BIN_DIR)/engine3d

.DEFAULT_GOAL := all

.DELETE_ON_ERROR:

# v3.0 Phase 0: module dependencies are GENERATED by
# tools/fortran_deps.sh into obj/deps.mk (one rule per object:
# its source, the objects of every module it USEs, and the recipe
# below).  This replaces ~30 hand-written rules; parallel builds
# (make -j) are safe because a consumer object depends on its
# providers' objects, and gfortran writes each .mod while compiling
# its provider into include/.
define FORTRAN_COMPILE
	@mkdir -p $(OBJ_DIR) $(MOD_DIR)
	$(FC) $(FFLAGS) -c $< -o $@
endef

DEPS = $(OBJ_DIR)/deps.mk

# The generator writes deps.mk itself (FORTRAN_DEPS_OUTPUT mode):
# incrementally (it skips when no source/script is newer than
# deps.mk) and atomically (unique mktemp file + rename).  The old
# `> $@.tmp; mv $@.tmp $@` pattern used a FIXED shared temp path:
# two concurrent make invocations raced on it, and an interrupted
# run left a stale temp behind -- do not reintroduce it.
$(DEPS): $(wildcard $(SRC_DIR)/*.f90) tools/fortran_deps.sh
	@mkdir -p $(OBJ_DIR)
	FORTRAN_DEPS_OUTPUT=$@ sh tools/fortran_deps.sh $(OBJ_DIR) FORTRAN_COMPILE "" $(SRC_DIR)/*.f90

ifeq ($(filter clean,$(MAKECMDGOALS)),)
-include $(DEPS)
endif

all: $(TARGET)

$(TARGET): $(FORTRAN_OBJS)
	@mkdir -p $(BIN_DIR)
	$(FC) $(FFLAGS) -o $@ $^

# Release build is the default (FFLAGS above, no -fcheck=all per
# MASTER-PLAN G1); 'make debug' rebuilds everything WITH -fcheck=all.
debug:
	$(MAKE) $(JOBS_FLAG) clean
	$(MAKE) $(JOBS_FLAG) all FFLAGS="$(DEBUG_FFLAGS)"

# The f3dc compiler is native (Fortran + C, sources in compiler/).
# Per ADR-2 it builds with gfortran + the system C compiler;
# `make f3dc` builds it and installs the binary next to the engine
# as bin/f3dc.
f3dc:
	$(MAKE) $(JOBS_FLAG) -C compiler
	@mkdir -p $(BIN_DIR)
	cp compiler/f3dc $(BIN_DIR)/f3dc

run: $(TARGET)
	@./$(TARGET)
	@which convert >/dev/null 2>&1 && convert output_render.ppm output_render.png && echo "[+] Converted to output_render.png" || true

test:
	./tests/run_tests.sh

minjs:
	@if command -v npx >/dev/null 2>&1 && npx --no-install terser --version >/dev/null 2>&1; then \
		echo "[+] Minifying runtime/f3d.js with terser (via npx)"; \
		npx --no-install terser runtime/f3d.js -o runtime/f3d.min.js; \
	else \
		echo "[+] terser not available; using sed fallback (strip full-line comments and blank lines)"; \
		sed -e '/^[[:space:]]*\/\//d' -e '/^[[:space:]]*$$/d' runtime/f3d.js > runtime/f3d.min.js; \
	fi
	@size=$$(wc -c < runtime/f3d.min.js); echo "runtime/f3d.min.js: $$size bytes (budget 15360)"; \
	if [ $$size -gt 15360 ]; then echo "[-] minjs OVER BUDGET: $$size > 15360" >&2; exit 1; fi

clean:
	rm -rf $(OBJ_DIR)/*.o $(OBJ_DIR)/deps.mk $(MOD_DIR)/*.mod $(BIN_DIR)/* output_render.ppm output_render.png

# Every non-file target in this Makefile is declared here
# (audited for `make -j` safety: all, debug, f3dc, run, test,
# minjs, clean -- the remaining targets are real files).
.PHONY: all debug f3dc run test minjs clean
