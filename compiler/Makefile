# Forge3D native compiler (f3dc) -- build rules.
#
# Toolchain (ADR-2, v3.0): FC = gfortran (>= 13), CC = cc (system C
# compiler).  flang-new-18/clang-18 are no longer required; the
# sources are standard-conforming and still build under flang
# (optional CI job).  Module dependencies are GENERATED by
# ../tools/fortran_deps.sh into build/deps.mk (v3.0 Phase 0 replaced
# the hand-maintained ordered source list + .NOTPARALLEL serial
# build), so parallel builds (make -j) are safe: a consumer object
# depends on the objects of every module it USEs, and gfortran/flang
# write each .mod while compiling its provider.
#
# INSTALL NOTE (bin/f3dc): the repo root's bin/ is where built
# binaries live (the top-level Makefile puts bin/engine3d there).
# This Makefile never writes outside compiler/; installation is the
# top-level Makefile's `make f3dc` target, which builds here and then
# copies compiler/f3dc -> ../bin/f3dc so `f3dc` sits next to the
# engine it drives.

FC       = gfortran
CC       = cc
FFLAGS   = -O2 -ffree-form
MODFLAGS = -Jbuild -Ibuild
CFLAGS   = -O2

BUILD_DIR = build
TARGET    = f3dc

.DEFAULT_GOAL := all

define FORTRAN_COMPILE
	$(FC) $(FFLAGS) $(MODFLAGS) -c $< -o $@
endef

SRC := $(sort $(wildcard src/*.f90))

# Generated dependency rules: build/deps.mk defines FORTRAN_OBJS and
# one rule per object (source + provider objects + the recipe above).
DEPS = $(BUILD_DIR)/deps.mk

$(DEPS): $(SRC) ../tools/fortran_deps.sh | $(BUILD_DIR)
	sh ../tools/fortran_deps.sh $(BUILD_DIR) FORTRAN_COMPILE $(BUILD_DIR) $(SRC) > $@.tmp
	mv $@.tmp $@

ifeq ($(filter clean,$(MAKECMDGOALS)),)
-include $(DEPS)
endif

OBJS = $(FORTRAN_OBJS)

# preview_http.c (C helper for `f3dc preview`) is optional:
# it is compiled and linked only when present.
ifneq ($(wildcard preview_http.c),)
C_OBJS = $(BUILD_DIR)/preview_http.o
else
C_OBJS =
endif

.PHONY: all clean test-smoke

all: $(TARGET)

$(TARGET): $(OBJS) $(C_OBJS)
	$(FC) $(FFLAGS) -o $@ $(OBJS) $(C_OBJS)

$(BUILD_DIR)/preview_http.o: preview_http.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

# Smoke test: the binary exists, reports its version, prints help,
# and rejects an unknown command with the usage exit code (2).
test-smoke: $(TARGET)
	./$(TARGET) --version
	./$(TARGET) --help > /dev/null
	@./$(TARGET) bogus > /dev/null 2>&1; rc=$$?; \
	if [ $$rc -ne 2 ]; then \
		echo "test-smoke FAIL: './$(TARGET) bogus' exited $$rc, want 2"; \
		exit 1; \
	fi
	@echo "test-smoke: OK (version, help, unknown-command exit 2)"
