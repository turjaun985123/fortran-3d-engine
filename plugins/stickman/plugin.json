              "channel": "root.face",
              "at": "end",
              "ease": "cue",
              "value": "clamp(atan2_deg(dest(target).x - cursor.x, dest(target).z - cursor.z), -180, 180)"
            }
          ]
        },
        {
          "when": {
            "all": [
              {
                "not": {
                  "any": [
                    {
                      "param_present": "target"
