              "at": "end",
              "value": 0,
              "ease": "cue"
            }
          ]
        },
        {
          "when": {
            "all": [
              {
                "ge": [
                  "dest(target).x",
                  "cursor.x"
                ]
              },
              {
                "not": {
                  "eq": [
                    "dest(target).x",
                    "cursor.x"
                  ]
                }
              }
